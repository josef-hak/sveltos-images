# One line per image we build from source.
#   <dir>|<upstream repo>|<image name>
# The image name is the chart's repository suffix: the chart asks for
# projectsveltos/<image name>, so a build has to be named that to drop in.
addon-controller|https://github.com/projectsveltos/addon-controller|addon-controller
classifier|https://github.com/projectsveltos/classifier|classifier
event-manager|https://github.com/projectsveltos/event-manager|event-manager
healthcheck-manager|https://github.com/projectsveltos/healthcheck-manager|healthcheck-manager
sveltoscluster-manager|https://github.com/projectsveltos/sveltoscluster-manager|sveltoscluster-manager
access-manager|https://github.com/projectsveltos/access-manager|access-manager
shard-controller|https://github.com/projectsveltos/shard-controller|shard-controller
crd-manager|https://github.com/projectsveltos/crd-manager|crd-manager
register-mgmt-cluster|https://github.com/projectsveltos/register-mgmt-cluster|register-mgmt-cluster
clusterinventory-controller|https://github.com/projectsveltos/clusterinventory-controller|clusterinventory-controller
sveltosctl|https://github.com/projectsveltos/sveltosctl|sveltosctl
